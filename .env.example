# URL interne du backend (appelée par les Server Components)
API_INTERNAL_URL=http://localhost:4000/api/v1
# Clé de service pour les lectures publiques
API_SERVICE_KEY=change-me
# Secret partagé avec le backend pour POST /api/revalidate
REVALIDATE_SECRET=change-me
# Origine publique des images (pilote local du backend, ou CDN)
NEXT_PUBLIC_MEDIA_URL=http://localhost:4000
# URL publique de la boutique (sitemap, canonical, données structurées)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
